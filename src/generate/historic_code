    for i in range(2):
        fig_part = sg.fromfile(paths[i])
        res_plot = fig_part.getroot()
        res_plot.moveto(x_0, y_0*i, scale_x=1, scale_y=1)
        reference=sg.TextElement(x_0+5,i*y_0+5, chr(ord('`')+i+2)+")", size=6)
